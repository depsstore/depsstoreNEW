{
    "version": 2,
    "builds": [{
        "src": "api/index.js",
        "use": "@vercel/node"
    }],
    "routes": [{
            "src": "/api/v2/(.*)",
            "dest": "/api/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/$1"
        }
    ],
    "rewrites": [{
        "source": "/api/v2/(.*)",
        "destination": "/api/index.js"
    }]
}