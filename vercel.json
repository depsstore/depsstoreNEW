{
    "version": 2,
    "builds": [{
        "src": "api/index.js",
        "use": "@vercel/node"
    }],
    "routes": [
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "src": "/api/v2/(.*)",
            "dest": "/api/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}
